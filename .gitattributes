# 二进制文件必须声明，否则在 core.autocrlf=true 的 Windows 上
# clone / checkout 时会被做 LF→CRLF 转换，文件直接损坏。
# git 的自动二进制探测靠采样前几 KB 有无 NUL 字节，对 PDF 这类
# 头部多为 ASCII 的格式会误判成文本。

*.pdf      binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.zip      binary

# SolidWorks（万一将来有人往仓库里放）
*.SLDPRT   binary
*.SLDASM   binary
*.SLDDRW   binary
*.sldprt   binary
*.sldasm   binary

# 三维交换格式
*.stl      binary
*.step     binary
*.stp      binary
*.x_t      binary
*.3mf      binary

*.md       text eol=lf
*.xlsx     binary
*.xls      binary
